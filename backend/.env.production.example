# =====================================================================
#  Suivi Démarches — réglages du VRAI serveur (modèle)
#  Copier ce fichier en « .env » sur le serveur, puis remplir chaque ligne.
#  Ce fichier rempli contient des secrets : ne jamais le publier ni le versionner.
#  Guide complet : docs/DEPLOIEMENT.md
# =====================================================================

APP_NAME="Suivi Démarches"
APP_ENV=production
APP_DEBUG=false
# Générée sur le serveur avec : php artisan key:generate
APP_KEY=
# Adresse publique de l'API et du site (en https)
APP_URL=https://suivi-demarches.sn
FRONTEND_URL=https://suivi-demarches.sn

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Si l'hébergeur place le site derrière un proxy qui gère le https (sinon laisser vide)
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suivi_demarches
# Un utilisateur MySQL dédié à l'application (jamais root), avec un mot de passe long
DB_USERNAME=suivi_demarches
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Durée d'une connexion : 7 jours, puis l'utilisateur se reconnecte
SANCTUM_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# E-mails (lien « mot de passe oublié ») : serveur SMTP fourni par l'hébergeur ou la messagerie
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ne-pas-repondre@suivi-demarches.sn"
MAIL_FROM_NAME="${APP_NAME}"

# Paiement Wave / Orange Money (PayDunya) : clés de PRODUCTION de l'application PayDunya
# (le compte PayDunya doit être validé avec les documents de la mairie ou de l'entreprise)
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_BOUTIQUE="Suivi Démarches"

# Assistant : laisser vide pour le mode guidé (sans IA)
ANTHROPIC_API_KEY=
ASSISTANT_MODELE=claude-opus-5-5
ASSISTANT_EFFORT=low
